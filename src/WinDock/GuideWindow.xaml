<Window x:Class="WinDock.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600" Height="450"
        Title="WinDock Guide"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Foreground="#FFF2F4F8"
        FontSize="13">
    <!-- WD-017 / AC-01：3 步首次引导。默认模式 C（仅美化），不隐藏原生任务栏。 -->
    <Border Background="#F21B1D26" BorderBrush="#33FFFFFF" BorderThickness="1"
            CornerRadius="12" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" MouseLeftButtonDown="OnTitleDrag" Background="Transparent">
                <TextBlock Text="WinDock" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="StepText" DockPanel.Dock="Right" Opacity="0.6"
                           VerticalAlignment="Center" />
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,22,0,16">
                <StackPanel x:Name="Step1">
                    <TextBlock x:Name="S1Title" FontSize="20" FontWeight="SemiBold"
                               Margin="0,0,0,14" />
                    <TextBlock x:Name="S1Text" TextWrapping="Wrap" LineHeight="22" Opacity="0.85" />
                </StackPanel>

                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <TextBlock x:Name="S2Title" FontSize="20" FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <TextBlock x:Name="S2Text" TextWrapping="Wrap" Opacity="0.75"
                               Margin="0,0,0,14" />
                    <RadioButton x:Name="ModeBeautify" IsChecked="True" Margin="0,7"
                                 GroupName="TaskbarMode" />
                    <RadioButton x:Name="ModeCoexist" Margin="0,7"
                                 GroupName="TaskbarMode" />
                    <RadioButton x:Name="ModeReplace" Margin="0,7"
                                 GroupName="TaskbarMode" />
                    <TextBlock x:Name="S2Hint" TextWrapping="Wrap" Opacity="0.6"
                               Margin="0,14,0,0" FontSize="12" />
                </StackPanel>

                <StackPanel x:Name="Step3" Visibility="Collapsed">
                    <TextBlock x:Name="S3Title" FontSize="20" FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <TextBlock x:Name="S3Text" TextWrapping="Wrap" Opacity="0.75"
                               Margin="0,0,0,12" />
                    <!-- 6.4 预设主题（P1）：与设置窗口共用同一套 ThemePresets，避免两处口径不一致 -->
                    <ComboBox x:Name="PresetCombo" Margin="0,0,0,16" />
                    <Border x:Name="PresetCapsule" HorizontalAlignment="Center"
                            CornerRadius="20" Padding="14" MinWidth="240"
                            BorderBrush="#33FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="8" Background="#4C78A0DC" Margin="4,0" />
                            <Border Width="40" Height="40" CornerRadius="8" Background="#4CDCA078" Margin="4,0" />
                            <Border Width="40" Height="40" CornerRadius="8" Background="#4CA0DC78" Margin="4,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <DockPanel Grid.Row="2">
                <Button x:Name="SkipButton" DockPanel.Dock="Left" MinWidth="90"
                        Padding="12,6" Background="Transparent" BorderBrush="#33FFFFFF"
                        Click="OnSkip" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" MinWidth="90" Margin="0,0,10,0"
                            Padding="12,6" Background="#22FFFFFF" BorderBrush="#33FFFFFF"
                            Click="OnBack" />
                    <Button x:Name="NextButton" MinWidth="110" Padding="12,6"
                            Background="#FF3B6FD4" BorderBrush="#FF3B6FD4" Foreground="White"
                            Click="OnNext" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
