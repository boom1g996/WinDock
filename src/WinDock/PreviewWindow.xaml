<Window x:Class="WinDock.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDock Preview"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Background="#F21B1D26"
        Foreground="#FFF2F4F8"
        FontSize="12">
    <!-- WD-014 / FR-401~404：DWM 缩略图直接绘制在本窗口 HWND 上，
         所以窗口必须是普通（非 layered）窗口；标题放在缩略图矩形之外，
         避免被 DWM 合成层覆盖。
         尺寸不再用 SizeToContent：面板实例长期复用（隐藏/再显示），
         SizeToContent 会像主窗口那样复用旧测量值，导致缩略图矩形与窗口错位。
         改为 Open() 里显式测量后写 Width/Height。 -->
    <Border x:Name="RootBorder" Padding="10" BorderBrush="#33FFFFFF" BorderThickness="1"
            CornerRadius="14">
        <StackPanel>
            <TextBlock x:Name="HeaderText" FontWeight="SemiBold" Margin="2,0,2,8"
                       Opacity="0.85" />
            <StackPanel x:Name="ItemsPanel" Orientation="Horizontal" />
        </StackPanel>
    </Border>
</Window>
