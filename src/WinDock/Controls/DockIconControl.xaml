<UserControl x:Class="WinDock.Controls.DockIconControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="48" Cursor="Hand" Focusable="True">
    <!-- RenderTransformOrigin=(0.5,1)：放大以底边对齐，向上生长，Dock 不抖动（D5） -->
    <Grid x:Name="Root" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="Translate" X="0" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Border x:Name="IconFrame" CornerRadius="8" Background="#14FFFFFF" ClipToBounds="True">
            <Image x:Name="IconImage" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" Margin="2" />
        </Border>
        <Ellipse x:Name="Indicator" Width="4" Height="4" Fill="#FFF2F4F8"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,-8" Visibility="Collapsed" />
    </Grid>
</UserControl>
