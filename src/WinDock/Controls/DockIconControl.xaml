<UserControl x:Class="WinDock.Controls.DockIconControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="48" Cursor="Hand" Focusable="True">
    <!-- RenderTransformOrigin=(0.5,1)：放大以底边对齐，向上生长，Dock 不抖动（D5） -->
    <Grid x:Name="Root" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="Translate" X="0" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>
        <!-- 图标框：只做圆角裁剪，不铺底色。原先的 #14FFFFFF 底会在非圆角图标外
             多出一圈淡方块，和底下的毛玻璃叠起来显脏；macOS 的图标本身就是圆角贴图。 -->
        <Border x:Name="IconFrame" CornerRadius="8" Background="Transparent" ClipToBounds="True">
            <Grid>
                <Image x:Name="IconImage" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <!-- FR-205 悬停 +4% 亮度：白色叠加层，由 hover 动画驱动透明度 -->
                <Border x:Name="HoverGlow" Background="White" Opacity="0" IsHitTestVisible="False" />
            </Grid>
        </Border>
        <!-- 8.4 名称显示把它移出图标框之外：原来压在图标底部的深色条会吃掉约 1/3 的
             图标高度，整排看过去就没有 macOS 那种"纯图标"的干净感。 -->
        <Border x:Name="LabelHost" VerticalAlignment="Top" HorizontalAlignment="Center"
                Background="#B3000000" CornerRadius="5" Padding="5,1,5,2"
                Margin="0,-20,0,0" Visibility="Collapsed" IsHitTestVisible="False"
                Panel.ZIndex="5">
            <TextBlock x:Name="Label" FontSize="10" Foreground="#FFF2F4F8"
                       TextTrimming="CharacterEllipsis" TextAlignment="Center"
                       MaxWidth="120" />
        </Border>
        <!-- 10 UI 规范：错误态图标上角红点，hover 由 ToolTip 说明原因 -->
        <Ellipse x:Name="ErrorDot" Width="8" Height="8" Fill="#FFE81123"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-1,-1,0" Visibility="Collapsed" IsHitTestVisible="False"
                 Stroke="#FF000000" StrokeThickness="1" />
        <!-- FR-102 / FR-204：运行指示点，样式与淡入缩放由代码/动画引擎驱动 -->
        <StackPanel x:Name="Indicator" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,-8" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <ScaleTransform x:Name="IndicatorScale" ScaleX="1" ScaleY="1" />
            </StackPanel.RenderTransform>
        </StackPanel>
    </Grid>
</UserControl>
