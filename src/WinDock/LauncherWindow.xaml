<Window x:Class="WinDock.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="760" Height="496"
        FontSize="12"
        Foreground="#FFF2F4F8"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- 启动台磁贴：透明底 + 悬停圆角高亮。用 Style 而不是在代码里拼 ControlTemplate，
             后者要手写 FrameworkElementFactory 树，既啰嗦又容易漏掉对齐设置。 -->
        <Style x:Key="LauncherTile" TargetType="Button">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="108" />
            <Setter Property="Margin" Value="2,4,2,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 分层窗口（AllowsTransparency=true）才能做出真圆角；
         启动台不需要 DWM 缩略图，所以不受「分层窗口不能注册 thumbnail」的限制。

         **不要在这里挂 Effect**：分层窗口 + DropShadowEffect = 整窗软件渲染，
         且任意子元素变化都要重算整窗高斯模糊（124 个磁贴分 7 批填充 = 7 次全窗
         模糊，实测把 CPU 打到 80%+，K-41）。阴影改用三层纯色 Border 叠出来，
         观感接近而代价近乎为零。 -->
    <Grid>
        <Border Margin="16,18,16,12" CornerRadius="26" Background="#0A000000"
                IsHitTestVisible="False" />
        <Border Margin="16,17,16,13" CornerRadius="24" Background="#18000000"
                IsHitTestVisible="False" />
        <Border x:Name="RootBorder" Margin="16" CornerRadius="20" BorderThickness="1"
                BorderBrush="#3DFFFFFF">
            <Border.Background>
                <SolidColorBrush Color="#F2161821" />
            </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="18,16,18,8" CornerRadius="10" Background="#1FFFFFFF">
                <Grid>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             Foreground="#FFF2F4F8" CaretBrush="#FFF2F4F8"
                             FontSize="13" Padding="12,8" VerticalContentAlignment="Center"
                             TextChanged="OnSearchTextChanged" />
                    <TextBlock x:Name="SearchHint" Text="搜索应用" FontSize="13" Opacity="0.45"
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="10,0,10,10"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="AppsPanel" Orientation="Horizontal" />
            </ScrollViewer>

            <TextBlock x:Name="StatusText" Grid.Row="1" Opacity="0.6" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
